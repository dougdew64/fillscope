{
  // Type-checks the plain JavaScript (JSDoc types, // @ts-check) without producing any output: the
  // extension runs from its source, so there is no compiled copy to fall out of date.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // Our code is checked against the packages' types; the packages' own declarations are not
    // re-checked (@vscode/debugprotocol uses a form of `module` that TypeScript 6 rejects).
    "skipLibCheck": true,
    "module": "commonjs",
    "target": "es2022",
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.js", "../../tests/vscode-debug-state/**/*.js"]
}
