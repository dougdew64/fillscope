{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake -S . -B build/debug -G Ninja -DCMAKE_BUILD_TYPE=Debug && cmake --build build/debug && ln -sf build/debug/compile_commands.json compile_commands.json",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test: affected (between edits)",
      "type": "shell",
      "command": "python3 -I tests/iterate.py",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test: everything (before a commit)",
      "type": "shell",
      "command": "tests/run-tests.sh",
      "group": "test",
      "problemMatcher": ["$gcc"]
    }
  ]
}
