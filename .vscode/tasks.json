{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake -S . -B build/debug -G Ninja -DCMAKE_BUILD_TYPE=Debug -DFILLSCOPE_WERROR=ON && cmake --build build/debug && ln -sf build/debug/compile_commands.json compile_commands.json",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      // For a client: the exchange's order port (12345, fixed in its code) open, or 30 seconds gone.
      "label": "wait for the exchange",
      "type": "shell",
      "command": "for i in $(seq 300); do (exec 3<>/dev/tcp/127.0.0.1/12345) 2>/dev/null && exit 0; sleep 0.1; done; echo 'the exchange did not open port 12345 within 30 seconds'; exit 1",
      "problemMatcher": []
    },
    {
      // The exchange's last recording (the "exchange" configuration makes it) through exchange_replay.
      "label": "replay the last recording",
      "type": "shell",
      "command": "cd build/debug/backend/Chapter12 && ./exchange_replay requests.rec market.dat",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      // A session of the book's clients and the slicer, recorded and replayed with its truth
      // (tools/sessions/record_session.py) into data/sessions/latest, which git ignores, replacing
      // the last: about 40 seconds, and 8.5 GB of memory while it records.
      "label": "record a session",
      "type": "shell",
      "command": "rm -rf data/sessions/latest && python3 -I tools/sessions/record_session.py data/sessions/latest",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      // The course's lessons, each played through the answer tool into build/debug/course/, for the
      // viewer to offer (viewer --course). Only the lessons changed since are played again.
      "label": "build the course",
      "type": "shell",
      "command": "cmake --build build/debug --target course",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "test: affected (between edits)",
      "type": "shell",
      "command": "python3 -I tests/scripts/iterate.py",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test: everything (before a commit)",
      "type": "shell",
      "command": "tests/scripts/run-tests.sh",
      "group": "test",
      "problemMatcher": ["$gcc"]
    }
  ]
}
