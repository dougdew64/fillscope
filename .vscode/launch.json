{
  // Debugger lockstep (docs/DEBUGGER-LOCKSTEP.md), under CodeLLDB. Start one of the compounds: the
  // viewer and the frame source each get a debug session.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "viewer",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/viewer",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "frame source (self-stop)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/frame_source",
      "args": ["--self-stop"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "frame source (breakpoint by name)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/frame_source",
      "preRunCommands": ["breakpoint set -n fillscope_frame_anchor"],
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "viewer + frame source (self-stop)",
      "configurations": ["viewer", "frame source (self-stop)"],
      "preLaunchTask": "build",
      "stopAll": true
    },
    {
      "name": "viewer + frame source (breakpoint by name)",
      "configurations": ["viewer", "frame source (breakpoint by name)"],
      "preLaunchTask": "build",
      "stopAll": true
    }
  ]
}
