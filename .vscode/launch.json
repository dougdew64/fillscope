{
  // The viewer beside the back end (backend/): the exchange and a client trading at random, each in a
  // debug session of its own, under CodeLLDB. Start the compound. The back end runs in its build
  // directory, where it writes its logs, and the exchange records its requests there
  // (requests.rec); "viewer (replay)" replays the last recording and shows it. The "lockstep"
  // compounds step the matcher through the last recording, one request per Continue, while the viewer
  // follows (docs/DEBUGGER-LOCKSTEP.md). "viewer + the whole market" runs every kind of client live;
  // "viewer (session)" records a session and shows it with its truth.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "viewer",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/viewer",
      "cwd": "${workspaceFolder}"
    },
    {
      // The last recording, replayed (the "replay the last recording" task), at any update.
      "name": "viewer (replay)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/viewer",
      "args": ["--replay", "${workspaceFolder}/build/debug/backend/Chapter12/market.dat"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "replay the last recording"
    },
    {
      // A session freshly recorded (the "record a session" task), shown with its truth: who sent each
      // order, and the slicer's trades in colour beside the book. The slicer's orders are on tickers
      // 1, 2 and 3; it opens on ticker 1.
      "name": "viewer (session)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/viewer",
      "args": ["--session", "${workspaceFolder}/data/sessions/latest", "--ticker", "1"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "record a session"
    },
    {
      // Answers: the assistant's answer to a question, written by fillscope-answer to
      // .fillscope/answer.json, shown as it is written and stepped through in a pane beside the book;
      // and the course's lessons, chosen from the pane's drop-down.
      "name": "viewer (answers)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/viewer",
      "args": ["--answer", "${workspaceFolder}/.fillscope/answer.json", "--course", "${workspaceFolder}/build/debug/course"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build the course"
    },
    {
      // The demo: lesson 6 of the course, a market maker, played in the viewer with real clicks at
      // a pace to follow, and checked at every frame, as the tests run it headless (viewer_demo.cpp).
      "name": "demo: a market maker",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/tests/viewer/viewer_demo",
      "args": ["${workspaceFolder}/build/debug/fillscope-answer", "${workspaceFolder}/course", "--watch"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    },
    {
      // The same, recorded as a video for sharing (with ffmpeg): quicker, in a 1280 by 720 window,
      // to build/debug/demo-a-market-maker.mp4.
      "name": "demo: record a market maker",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/tests/viewer/viewer_demo",
      "args": ["${workspaceFolder}/build/debug/fillscope-answer", "${workspaceFolder}/course", "--record",
               "${workspaceFolder}/build/debug/demo-a-market-maker.mp4"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    },
    {
      // The live demo: the viewer on the real exchange and a client trading at random, for 30
      // seconds from just before the first orders, showing other tickers' books and pointing at
      // orders at set times, checked against the demo's own books (viewer_demo.cpp).
      "name": "demo: live trading",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/tests/viewer/viewer_demo",
      "args": ["--live", "${workspaceFolder}/build/debug/backend/Chapter12/exchange_main",
               "${workspaceFolder}/build/debug/backend/Chapter12/trading_main", "--watch"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    },
    {
      // The same, recorded as a video for sharing (with ffmpeg), in a 1280 by 720 window, to
      // build/debug/demo-live-trading.mp4.
      "name": "demo: record live trading",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/tests/viewer/viewer_demo",
      "args": ["--live", "${workspaceFolder}/build/debug/backend/Chapter12/exchange_main",
               "${workspaceFolder}/build/debug/backend/Chapter12/trading_main", "--record",
               "${workspaceFolder}/build/debug/demo-live-trading.mp4"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    },
    {
      // The time-shifting demo: the live viewer paused, an order pointed at in the still book, stepped
      // back to before it arrived and forward to see it arrive, played behind live, and back to live,
      // checked against the demo's own books (viewer_demo.cpp).
      "name": "demo: time-shifting",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/tests/viewer/viewer_demo",
      "args": ["--time-shift", "${workspaceFolder}/build/debug/backend/Chapter12/exchange_main",
               "${workspaceFolder}/build/debug/backend/Chapter12/trading_main", "--watch"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    },
    {
      // The same, recorded as a video for sharing (with ffmpeg), in a 1280 by 720 window, to
      // build/debug/demo-time-shifting.mp4.
      "name": "demo: record time-shifting",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/tests/viewer/viewer_demo",
      "args": ["--time-shift", "${workspaceFolder}/build/debug/backend/Chapter12/exchange_main",
               "${workspaceFolder}/build/debug/backend/Chapter12/trading_main", "--record",
               "${workspaceFolder}/build/debug/demo-time-shifting.mp4"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    },
    {
      // The slicing demo: a session recorded (about 40 seconds, 8.5 GB of memory meanwhile), then the
      // slicer's trades played and followed in the viewer, piece by piece, on each of its tickers,
      // checked against the demo's own books and the recording's truth (viewer_demo.cpp).
      "name": "demo: slicing",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/tests/viewer/viewer_demo",
      "args": ["--slicing", "python3", "${workspaceFolder}/tools/sessions/record_session.py",
               "${workspaceFolder}/build/debug/backend/Chapter12/exchange_main",
               "${workspaceFolder}/build/debug/backend/Chapter12/trading_main",
               "${workspaceFolder}/build/debug/backend/Chapter12/exchange_replay", "--watch"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    },
    {
      // The same, recorded as a video for sharing (with ffmpeg), in a 1920 by 1080 window (larger than
      // the other demos', so the trades panel has room for its chart), to build/debug/demo-slicing.mp4.
      "name": "demo: record slicing",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/tests/viewer/viewer_demo",
      "args": ["--slicing", "python3", "${workspaceFolder}/tools/sessions/record_session.py",
               "${workspaceFolder}/build/debug/backend/Chapter12/exchange_main",
               "${workspaceFolder}/build/debug/backend/Chapter12/trading_main",
               "${workspaceFolder}/build/debug/backend/Chapter12/exchange_replay", "--record",
               "${workspaceFolder}/build/debug/demo-slicing.mp4"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    },
    {
      // A snapshot every 5 seconds, where the book's exchange has a minute, so a viewer started late
      // catches up quickly; each run's requests recorded, replacing the last run's.
      "name": "exchange",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/backend/Chapter12/exchange_main",
      "args": ["--snapshot-interval-seconds", "5", "--record", "requests.rec"],
      "cwd": "${workspaceFolder}/build/debug/backend/Chapter12"
    },
    {
      // The last recording replayed, each request's updates sent to the viewer before the debugger
      // stops in the anchor (self-stop: no breakpoint needed).
      "name": "replay (self-stop)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/backend/Chapter12/exchange_replay",
      "args": ["requests.rec", "--publish", "233.252.14.3:20001", "--self-stop"],
      "cwd": "${workspaceFolder}/build/debug/backend/Chapter12"
    },
    {
      // The same, stopped by a breakpoint set on the anchor by name instead.
      "name": "replay (breakpoint by name)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/backend/Chapter12/exchange_replay",
      "args": ["requests.rec", "--publish", "233.252.14.3:20001"],
      "preRunCommands": ["breakpoint set -n fillscope_request_anchor"],
      "cwd": "${workspaceFolder}/build/debug/backend/Chapter12"
    },
    {
      // The whole market, live: the exchange, the book's market maker, liquidity taker and random
      // client, and the slicer, as a session records them (record_session.py --live), until stopped.
      // Its recording and logs go to data/sessions/live. Every program stops with it. 8.5 GB of memory.
      "name": "the whole market (live)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/sessions/record_session.py",
      "args": ["${workspaceFolder}/data/sessions/live", "--live"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      // Client 5 trades at random. It needs the exchange's order port open, which takes the exchange
      // about ten seconds.
      "name": "client (random)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/backend/Chapter12/trading_main",
      "args": ["5", "RANDOM"],
      "cwd": "${workspaceFolder}/build/debug/backend/Chapter12",
      "preLaunchTask": "wait for the exchange"
    }
  ],
  "compounds": [
    {
      "name": "viewer + exchange + client",
      "configurations": ["viewer", "exchange", "client (random)"],
      "preLaunchTask": "build",
      "stopAll": true
    },
    {
      // The viewer live on the whole market: the slicer's trades are there, but live, nothing says
      // whose they are (record a session, and "viewer (session)", for that).
      "name": "viewer + the whole market",
      "configurations": ["viewer", "the whole market (live)"],
      "preLaunchTask": "build",
      "stopAll": true
    },
    {
      // Lockstep: the viewer, live, listening where the replay publishes; the replay stopped after each
      // request. Needs a recording: run "viewer + exchange + client" first. No exchange may be running.
      "name": "lockstep: viewer + replay (self-stop)",
      "configurations": ["viewer", "replay (self-stop)"],
      "preLaunchTask": "build",
      "stopAll": true
    },
    {
      "name": "lockstep: viewer + replay (breakpoint by name)",
      "configurations": ["viewer", "replay (breakpoint by name)"],
      "preLaunchTask": "build",
      "stopAll": true
    }
  ]
}
